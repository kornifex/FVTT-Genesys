{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "Bundler",

		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"jsx": "preserve",

		"allowJs": true,
		"checkJs": true,

		"noImplicitOverride": true,

		"paths": {
			"@/*": ["./src/*"],
		},
		"lib": [
			"ES2022",
			"DOM"
		],
		"typeRoots": [
			"node_modules",
			"node_modules/handlebars",
            "node_modules/@types",
			"types"
		],
		"types": [
			"dice-so-nice",
			"foundry",
			"foundry-v13",
			"handlebars",
			"jquery",
			"node",
			"socket.io",
			"vite/client"
		]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"src/**/*.tsx",
		"src/**/*.vue",
	],
	"exclude": [
		"node_modules"
	]
}
