{
	"name": "genesys",
	"version": "0.5.0-rc.1",
	"description": "Unofficial implementation of the Genesys RPG for Foundry",
	"repository": "https://github.com/kornifex/FVTT-Genesys",
	"author": "kornifex",
	"license": "MIT",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": "^24"
	},
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"e2e": "node e2e/run.ts",
		"e2e:all": "node e2e/run.ts e2e/scenarios",
		"lint": "eslint --max-warnings=0 src build e2e *.config.ts",
		"knip": "knip",
		"i18n": "node build/checkI18n.ts",
		"format": "prettier --write src/ types/ build/ \"e2e/**/*.ts\" yaml/ *.config.ts",
		"format:check": "prettier --check src/ types/ build/ \"e2e/**/*.ts\" yaml/ *.config.ts",
		"test": "vitest run",
		"typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json && tsc -p e2e/tsconfig.json"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@foundryvtt/foundryvtt-cli": "3.0.5",
		"@types/jquery": "^3.5.29",
		"@types/node": "^24.19.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"dotenv": "^16.0.3",
		"dotenv-expand": "^10.0.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.11.1",
		"fvtt-types": "14.369.0-beta.20261027165341",
		"handlebars": "^4.7.7",
		"js-yaml": "^5.5.0",
		"knip": "^6.42.1",
		"playwright-core": "^1.64.1",
		"prettier": "^3.2.4",
		"sass": "1.105.2",
		"socket.io": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4",
		"vitest": "5.0.5",
		"vue": "^3.5.44",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "^3.3.13"
	}
}
