{
	"name": "genesys",
	"version": "0.3.1",
	"description": "Unofficial implementation of the Genesys RPG for Foundry",
	"repository": "https://github.com/kornifex/FVTT-Genesys",
	"author": "kornifex",
	"license": "MIT",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": "^24"
	},
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"lint": "eslint src --ext .vue,.js,.ts",
		"format": "prettier --write src/ types/",
		"format:check": "prettier --check src/ types/",
		"test": "vitest run",
		"typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json"
	},
	"devDependencies": {
		"@rushstack/eslint-patch": "^1.7.2",
		"@types/jquery": "^3.5.29",
		"@types/node": "^24.19.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/eslint-config-prettier": "^9.0.0",
		"@vue/eslint-config-typescript": "^12.0.0",
		"@yeger/vue-masonry-wall": "^5.0.6",
		"dotenv": "^16.0.3",
		"dotenv-expand": "^10.0.0",
		"eslint": "^8.56.0",
		"eslint-plugin-vue": "^9.21.0",
		"handlebars": "^4.7.7",
		"js-yaml": "^5.5.0",
		"prettier": "^3.2.4",
		"sass": "1.105.2",
		"socket.io": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "5.0.5",
		"vue": "^3.5.44",
		"vue-tsc": "^3.3.13"
	}
}
