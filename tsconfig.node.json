{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023"],
		"types": ["node"],

		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": ["*.config.ts", "build/**/*.ts"]
}
