{{!-- The card of a check, with the damage and qualities of the attack in its slots. --}}
{{#*inline "attackDetails"}}
	{{#if showAttackDetails}}
		<label>{{localize 'Genesys.Rolls.Attack.Label'}}</label>
		<div class="summary-table">
			{{!-- Damage --}}
			<span class="symbol"><i class="fas fa-user-injured"></i></span>
			<span class="label">{{localize 'Genesys.Rolls.Attack.Damage'}} ({{damageFormula}})</span>
			<span class="count">{{totalDamage}}</span>

			<div class="separator"></div>

			{{!-- Critical --}}
			<span class="symbol"><i class="fas fa-explosion"></i></span>
			<span class="label">{{localize 'Genesys.Rolls.Attack.Critical'}}</span>
			<span class="count">{{critical}}</span>

			<div class="separator"></div>

			{{!-- How many times the attack triggers a Critical Injury, which the roller rolls from the button below. --}}
			{{#if criticalTriggers}}
			<span class="symbol"><i class="fas fa-burst"></i></span>
			<span class="label">{{localize 'Genesys.CriticalInjuryPrompt.CardTriggers'}}</span>
			<span class="count">{{criticalTriggers}}</span>

			<div class="separator"></div>
			{{/if}}
		</div>

		{{#if criticalTriggers}}
		<button type="button" class="roll-critical-injury"><i class="fas fa-dice-d20"></i> {{localize 'Genesys.CriticalInjuryPrompt.Open'}}</button>
		{{/if}}
	{{/if}}
{{/inline}}

{{#*inline "attackQualities"}}
	{{!-- Attack Qualities --}}
	{{#if qualities}}
		<label>{{localize 'Genesys.Rolls.Attack.Qualities'}}</label>
		<div class="qualities">
			{{#each qualities}}
				<a class="quality" data-tooltip="{{or description 'Genesys.Tooltips.NoDescription'}}">{{name}} {{#if isRated}}{{rating}}{{/if}}</a>
			{{/each}}
		</div>
	{{/if}}
{{/inline}}

{{> "systems/genesys/templates/chat/rolls/skill.hbs"}}
