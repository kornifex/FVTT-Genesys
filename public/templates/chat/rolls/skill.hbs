{{!-- The card of a check, which attack.hbs calls as a partial: it fills the attackDetails and attackQualities slots with inline partials of those names, which a check's card leaves empty. --}}
<div class="roll roll-skill">
	{{!-- Formatted Results --}}
	<div class="results-row">
		{{#if description}}
			<div class="roll-description">{{{description}}}</div>
		{{/if}}

		<label>{{localize 'Genesys.Rolls.Results'}}</label>
		<div class="net-results" {{glyphAttributes card.symbols}}>
			{{#each card.symbols}}
				<span>{{this}}</span>
			{{/each}}
		</div>

		{{#> attackDetails}}
		{{/attackDetails}}

		<label>{{localize 'Genesys.Rolls.Summary.Label'}}</label>
		<div class="summary-table">
			{{#each card.summary}}
				{{!-- The label that follows names the symbol in words. --}}
				<span class="symbol" aria-hidden="true">{{symbol}}</span>
				<span class="label">{{localize label}}</span>
				<span class="count">{{count}}</span>

				<div class="separator"></div>
			{{/each}}
		</div>

		{{#> attackQualities}}
		{{/attackQualities}}

		{{!-- The Additional Effects a spell is cast with, each with its qualities, and the strain casting costs the caster (CRB p. 210). --}}
		{{#if spell}}
			{{#if spell.effects}}
				<label>{{localize 'Genesys.Rolls.Spell.AdditionalEffects'}}</label>
				<ul class="spell-effects">
					{{#each spell.effects}}
						<li class="spell-effect">
							<span class="name">{{name}}</span>
							{{#each qualities}}
								<a class="quality" data-tooltip="{{or description 'Genesys.Tooltips.NoDescription'}}">{{name}} {{#if isRated}}{{rating}}{{/if}}</a>
							{{/each}}
						</li>
					{{/each}}
				</ul>
			{{/if}}

			<div class="summary-table spell-strain">
				<span class="symbol" aria-hidden="true"><i class="fas fa-face-tired"></i></span>
				<span class="label">{{localize 'Genesys.Rolls.Spell.Strain'}}</span>
				<span class="count">{{spell.strain}}</span>

				<div class="separator"></div>
			</div>
		{{/if}}

		{{!-- What a check that heals heals its patient of, and the button that heals them, which src/dice/recoveryCard.ts shows only to the GM and the patient's owners. A check that heals no wound, as the end of an encounter's, shows the strain alone. --}}
		{{#if recovery}}
			<label>{{localize recovery.label patient=recovery.patientName}}</label>
			<div class="summary-table recovery">
				{{#if recovery.healsWounds}}
					<span class="symbol" aria-hidden="true"><i class="fas fa-heart-pulse"></i></span>
					<span class="label">{{localize 'Genesys.Recovery.Wounds'}}</span>
					<span class="count">{{recovery.wounds}}</span>

					<div class="separator"></div>
				{{/if}}

				<span class="symbol" aria-hidden="true"><i class="fas fa-face-tired"></i></span>
				<span class="label">{{localize 'Genesys.Recovery.Strain'}}</span>
				<span class="count">{{recovery.strain}}</span>

				<div class="separator"></div>
			</div>
			{{#if recovery.applicable}}
				<button type="button" class="apply-recovery"><i class="fas fa-kit-medical" aria-hidden="true"></i> {{localize 'Genesys.Recovery.Apply'}}</button>
			{{/if}}
		{{/if}}
	</div>

	{{!-- Dice --}}
	<div class="dice-row">
		<label>{{localize 'Genesys.Rolls.Dice'}}</label>
		<div class="dice">
			{{#each results.faces as |faces die|}}
				{{#each faces}}
					<div class="result" {{glyphAttributes this die=die}}>
						<div class="type" data-type="{{capitalize die}}">
							<span>
								{{!-- Convert difficulty to the correct symbol --}}
								{{#if (eq die 'i')}}
									D
								{{else}}
									{{capitalize die}}
								{{/if}}
							</span>
						</div>
						<div class="face" data-type="{{capitalize die}}">
							<span>{{this}}</span>
						</div>
					</div>
				{{/each}}
			{{/each}}

			{{#each results.extraSymbols as |count symbol|}}
				{{#repeat count}}
					<div class="symbol" {{glyphAttributes symbol}}>{{symbol}}</div>
				{{/repeat}}
			{{/each}}
		</div>
	</div>
</div>
