{{!-- The offer of a character's Critical Injury, once their wounds exceed their threshold: its button opens the dialog that rolls it. --}}
<div class="critical-injury-offer">
	<p>{{localize 'Genesys.ThresholdStates.CriticalInjuryOffer' actor=actor}}</p>
	<button type="button" class="roll-critical-injury"><i class="fas fa-dice-d20"></i> {{localize 'Genesys.CriticalInjuryPrompt.Open'}}</button>
</div>
