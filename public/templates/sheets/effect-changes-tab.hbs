<section class="tab changes{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
	<header>
		<div class="key">{{localize "EFFECT.FIELDS.changes.element.key.label"}}</div>
		<div class="mode">{{localize "EFFECT.FIELDS.changes.element.type.label"}}</div>
		<div class="value">{{localize "EFFECT.FIELDS.changes.element.value.label"}}</div>
		<div class="priority">{{localize "EFFECT.FIELDS.changes.element.priority.label"}}</div>
		<div class="controls"><a data-action="addChange"><i class="fa-regular fa-square-plus"></i></a></div>
	</header>
	<ol class="scrollable">
		{{#each changes as |change i|}}
		<li data-index="{{i}}">
			<div class="key">
				<select name="{{@root.changesPath}}.{{i}}.key">
					{{selectOptions @root.keys selected=change.key blank="—"}}
				</select>
			</div>
			<div class="mode">
				{{!-- A Pool Modification of every check of a kind, a change to Critical Injury rolls and an Item Change have no subject and no mode. --}}
				<div class="check-selection initial-hide {{#if (eq change.subjectField 'check-selection')}}show-it{{/if}}">—</div>
				<select name="{{@root.changesPath}}.{{i}}.char" class="characteristic-selection initial-hide {{#if (eq change.subjectField 'characteristic-selection')}}show-it{{/if}}">
					{{selectOptions @root.characteristics selected=change.char valueAttr="characteristic" labelAttr="label" localize=true sort=true}}
				</select>
				<select name="{{@root.changesPath}}.{{i}}.skill" class="skill-selection initial-hide {{#if (eq change.subjectField 'skill-selection')}}show-it{{/if}}">
					{{selectOptions @root.skills selected=change.skill sort=true}}
				</select>
				<select name="system.changes.{{i}}.type" class="effect-mode initial-hide {{#if (eq change.subjectField 'effect-mode')}}show-it{{/if}}">
					{{selectOptions @root.changeTypes selected=change.type}}
				</select>
				<input type="hidden" name="system.changes.{{i}}.phase" value="{{change.phase}}">
			</div>
			<div class="value">
				{{formInput @root.changeFields.value name=(concat @root.changesPath "." i ".value") value=change.value elementType="input"}}
			</div>
			{{!-- A change's default priority depends on its type. --}}
			<div class="priority">
				{{formInput @root.changeFields.priority name=(concat @root.changesPath "." i ".priority") value=change.priority
				placeholder=(lookup @root.priorities change.type)}}
			</div>
			<div class="controls"><a data-action="deleteChange"><i class="fa-solid fa-trash"></i></a></div>
		</li>
		{{/each}}
	</ol>
</section>
