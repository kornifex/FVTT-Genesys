{{#*inline "initiative"}}
	<div class="token-initiative">
		{{#if hasRolled}}
			<span class="initiative font-genesys-symbols">{{#repeat successes}}s{{/repeat}}{{#repeat advantages}}a{{/repeat}}</span>
		{{else if canRollInitiative}}
			<button type="button" class="combatant-control roll" data-action="rollInitiative" data-tooltip aria-label="{{localize "COMBAT.InitiativeRoll"}}" style="--initiative-icon: url('{{@root.initiativeIcon.icon}}'); --initiative-icon-hover: url('{{@root.initiativeIcon.hover}}');"></button>
		{{/if}}
	</div>
{{/inline}}

<ol class="combat-tracker plain">
	{{#each turns}}
		{{#if claimed}}
			<li class="combatant claimed slot-{{slotType}} {{css}}" data-combatant-id="{{id}}" data-slot-id="{{slotId}}" data-action="activateCombatant">
				<img class="token-image" src="{{img}}" alt="{{name}}" loading="lazy">

				<div class="token-name">
					<strong class="name">{{name}}</strong>
					<div class="combatant-controls">
						{{#if (and canRollInitiative (not hasRolled))}}
							<button type="button" class="inline-control combatant-control initiative-skill" data-action="cycleInitiativeSkill" data-tooltip="Genesys.Tooltips.CycleInitiativeSkill">{{initiativeSkill}}</button>
						{{/if}}
						{{#if @root.user.isGM}}
							<button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}" data-action="toggleHidden" data-tooltip aria-label="{{localize "COMBAT.ToggleVis"}}"></button>
							<button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}" data-action="toggleDefeated" data-tooltip aria-label="{{localize "COMBAT.ToggleDead"}}"></button>
						{{/if}}
						{{#if canPing}}
							<button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye" data-action="pingCombatant" data-tooltip aria-label="{{localize "COMBAT.PingCombatant"}}"></button>
						{{/if}}
						{{#unless @root.user.isGM}}
							<button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye" data-action="panToCombatant" data-tooltip aria-label="{{localize "COMBAT.PanToCombatant"}}"></button>
						{{/unless}}
						<div class="token-effects" data-tooltip-html="{{effects.tooltip}}">
							{{#each effects.icons}}
								<img class="token-effect" src="{{img}}" alt="{{name}}">
							{{/each}}
						</div>
					</div>
				</div>

				{{#if resource includeZero=true}}
					<div class="token-resource">
						<span class="resource">{{resource}}</span>
					</div>
				{{/if}}

				{{> initiative}}
			</li>
		{{else}}
			<li class="combatant initiative-slot slot-{{slotType}} {{css}}" data-combatant-id="{{id}}" data-slot-id="{{slotId}}">
				<div class="token-name">
					{{#if (and canClaim active)}}
						<button type="button" class="claim-slot" data-action="claimInitiativeSlot">{{localize "Genesys.CombatTracker.ClaimInitiativeSlot"}}</button>
					{{else}}
						<strong class="name">{{localize (concat "Genesys.CombatTracker.InitiativeSlot." slotType)}}</strong>
					{{/if}}
				</div>

				{{> initiative}}
			</li>
		{{/if}}
	{{/each}}
</ol>
